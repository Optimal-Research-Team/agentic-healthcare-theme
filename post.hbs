{{!< default}}

<div class="progress" aria-hidden="true"><span data-progress></span></div>

{{#post}}
<article class="article {{post_class}}">
    <section class="band band--post" aria-hidden="true"><canvas class="hero__canvas" data-gradient></canvas></section>

    <header class="article__head container">
        <a class="article__back" href="{{@site.url}}/#essays"><span class="arrow arrow--back" aria-hidden="true"></span> All essays</a>
        <p class="kicker">{{#primary_tag}}<a href="{{url}}">{{name}}</a>{{else}}Essay{{/primary_tag}}</p>
        <h1 class="article__title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="article__dek">{{custom_excerpt}}</p>{{/if}}
        <div class="article__meta">
            {{#primary_author}}
                <a class="byline" href="{{url}}">
                    {{> avatar}}
                    <span class="byline__name">{{name}}</span>
                </a>
            {{/primary_author}}
            <span class="dot" aria-hidden="true"></span>
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMMM D, YYYY"}}</time>
            <span class="dot" aria-hidden="true"></span>
            <span>{{reading_time}}</span>
        </div>
    </header>

    {{#if feature_image}}
        <figure class="article__image container">
            <img srcset="{{img_url feature_image size="m"}} 800w, {{img_url feature_image size="l"}} 1200w, {{img_url feature_image size="xl"}} 2000w"
                 sizes="(max-width: 1100px) 100vw, 1040px"
                 src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}

    <div class="article__body gh-content">
        {{content}}
    </div>

    <footer class="article__foot">
        <div class="share">
            <span class="share__label">Share</span>
            <a class="chip" href="https://www.linkedin.com/sharing/share-offsite/?url={{url absolute="true"}}" target="_blank" rel="noopener">LinkedIn</a>
            <a class="chip" href="https://x.com/intent/tweet?url={{url absolute="true"}}&text={{encode title}}" target="_blank" rel="noopener">X</a>
            <button class="chip" type="button" data-copy="{{url absolute="true"}}">Copy link</button>
        </div>
    </footer>
</article>

{{#get "posts" filter="id:-{{id}}" limit="3" include="tags" as |related|}}
    {{#if related}}
    <section class="section section--related">
        <div class="container">
            <header class="section__head">
                <div>
                    <p class="kicker">Keep reading</p>
                    <h2 class="section__title section__title--sm">More essays</h2>
                </div>
                <a class="link-arrow" href="{{@site.url}}/#essays">All essays <span class="arrow" aria-hidden="true"></span></a>
            </header>
            <div class="rows">
                {{#foreach related}}
                    {{> post-row}}
                {{/foreach}}
            </div>
        </div>
    </section>
    {{/if}}
{{/get}}
{{/post}}
