{{!-- Illustrative agent run. Steps are driven by assets/js/main.js; all data is fictional. --}}
<div class="console" data-console>
    <div class="console__bar">
        <span class="console__dots"><i></i><i></i><i></i></span>
        <span class="console__name"><span class="console__glyph">⌁</span> agent / <b data-console-name>referral-intake</b></span>
        <span class="console__demo" title="Illustrative demo — fictional data">Demo</span>
        <span class="console__status" data-console-status><i></i>Running</span>
    </div>
    <ol class="console__steps" data-console-steps>
        {{!-- no-JS fallback --}}
        <li class="step is-done"><span class="step__icon"></span><span class="step__text">Fax received · 4 pages</span><span class="step__time">0.4s</span></li>
        <li class="step is-done"><span class="step__icon"></span><span class="step__text">Classified as cardiology referral</span><span class="step__time">1.1s</span></li>
        <li class="step is-done"><span class="step__icon"></span><span class="step__text">Patient matched in EMR</span><span class="step__time">0.8s</span></li>
        <li class="step is-done"><span class="step__icon"></span><span class="step__text">Missing ECG requested from sender</span><span class="step__time">2.3s</span></li>
        <li class="step is-done"><span class="step__icon"></span><span class="step__text">Booked first available · Tue 10:40</span><span class="step__time">1.6s</span></li>
    </ol>
    <div class="console__foot">
        <span class="console__outcome" data-console-outcome>11 min of admin work, done before the coffee cools.</span>
        <span class="console__tabs" data-console-tabs></span>
    </div>
</div>
