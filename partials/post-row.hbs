<article class="row {{post_class}}">
    <a class="row__link" href="{{url}}">
        <time class="row__date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="MMM D, YYYY"}}</time>
        <div class="row__body">
            <p class="row__tag">{{#primary_tag}}{{name}}{{else}}Essay{{/primary_tag}}</p>
            <h3 class="row__title">{{title}}</h3>
            <p class="row__excerpt">{{excerpt words="28"}}</p>
        </div>
        <div class="row__thumb">
            {{#if feature_image}}
                <img src="{{img_url feature_image size="s"}}" alt="" loading="lazy">
            {{else}}
                <div class="art" data-art="{{slug}}" aria-hidden="true"></div>
            {{/if}}
        </div>
        <span class="row__meta">{{reading_time}} <span class="arrow" aria-hidden="true"></span></span>
    </a>
</article>
