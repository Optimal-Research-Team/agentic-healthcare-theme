{{#unless @member}}{{#if @site.members_enabled}}
<section class="cta">
    <div class="container cta__inner">
        <div class="cta__copy">
            <p class="kicker">Newsletter · Free</p>
            <h2 class="cta__title">New essays on healthcare AI, straight to your inbox.</h2>
            <p class="cta__sub">Occasional, considered writing on AI agents, clinical operations and the Canadian health system. No spam — unsubscribe anytime.</p>
        </div>
        {{> subscribe-form}}
    </div>
</section>
{{/if}}{{/unless}}

<footer class="footer">
    <div class="container footer__inner">
        <div class="footer__brand">
            <a class="nav__brand" href="{{@site.url}}">
                <img class="nav__mark" src="{{asset "brand/favicon.svg"}}" alt="" width="26" height="26">
                <span class="nav__title">{{@site.title}}</span>
            </a>
            <p class="footer__tag">Writing on AI agents and the future of Canadian healthcare.</p>
        </div>
        <nav class="footer__nav" aria-label="Footer">
            {{navigation}}
            {{navigation type="secondary"}}
        </nav>
    </div>
    <div class="container footer__base">
        <span>&copy; {{date format="YYYY"}} {{@site.title}}</span>
        <span class="footer__meta"><a href="{{@site.url}}/rss/">RSS</a> · Published with <a href="https://ghost.org" target="_blank" rel="noopener">Ghost</a></span>
    </div>
</footer>
